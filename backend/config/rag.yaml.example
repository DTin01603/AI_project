# RAG System Configuration Example
# Copy this file to rag.yaml and customize as needed

# Database configuration
db_path: "data/rag.db"

# Embedding configuration
embedding_model: "paraphrase-multilingual-MiniLM-L12-v2"
embedding_dimension: 384  # 384 for MiniLM, 768 for mpnet-base, 1536 for OpenAI

# Vector store configuration
vector_store_path: "data/vector_store"

# Search configuration
default_search_method: "hybrid"  # Options: fts, vector, hybrid
fts_weight: 0.3  # Weight for FTS scores in hybrid search (must sum to 1.0 with vector_weight)
vector_weight: 0.7  # Weight for vector scores in hybrid search
default_top_k: 5  # Default number of results to return
min_relevance_score: 0.1  # Minimum relevance score threshold

# Re-ranking configuration
enable_reranking: true
reranker_model: "cross-encoder/ms-marco-MiniLM-L-6-v2"
rerank_top_n: 100  # Number of candidates to re-rank

# Chunking configuration
chunk_size: 800  # Target chunk size in tokens
chunk_overlap: 300  # Overlap between chunks in characters
chunking_strategy: "recursive"  # Options: recursive, semantic, code-aware

# Advanced retrieval features
enable_query_expansion: false
enable_compression: false
enable_citations: false
enable_multi_query: false
query_expansion_count: 3
compression_min_ratio: 0.2
compression_max_ratio: 0.8

# Performance tuning
cache_size: 1000
batch_size: 32
